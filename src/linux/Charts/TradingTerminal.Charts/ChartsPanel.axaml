<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TradingTerminal.Charts"
             x:Class="TradingTerminal.Charts.ChartsPanel"
             Background="#0A0A0A"
             Foreground="#D1D4DC">
  <UserControl.Resources>
    <local:AvaloniaInstrumentTagsConverter x:Key="InstrumentTags" />
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border x:Name="Toolbar"
            Grid.Row="0"
            Background="#1E222D"
            BorderBrush="#2A2E39"
            BorderThickness="0,0,0,1"
            Padding="10,7">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <StackPanel x:Name="ResearchShellWorkflow" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding ResearchShellProgressText}" FontSize="10" Foreground="#9AA0AC"
                     VerticalAlignment="Center" Width="320" TextWrapping="Wrap"
                     ToolTip.Tip="{Binding ResearchShellNextHint}" />
          <TextBlock Text="{Binding ResearchShellNextHint}" FontSize="10" Foreground="#787B86"
                     VerticalAlignment="Center" MaxWidth="280" TextWrapping="Wrap"
                     ToolTip.Tip="Research shell next step (draft only — no broker orders)." />
          <Border Width="1" Height="24" Background="#2A2E39" />
          <TextBlock Text="From" FontSize="10" Foreground="#787B86" VerticalAlignment="Center" />
          <TextBox Width="140" Text="{Binding HistoryFromText}" Watermark="UTC from"
                   ToolTip.Tip="UTC start (yyyy-MM-dd or yyyy-MM-dd HH:mm:ss). Full timestamps preserve intraday ranked windows." />
          <TextBlock Text="To" FontSize="10" Foreground="#787B86" VerticalAlignment="Center" />
          <TextBox Width="140" Text="{Binding HistoryToText}" Watermark="UTC to"
                   ToolTip.Tip="UTC end exclusive. Prefer full timestamps for same-day windows." />
          <Button Content="Load history"
                  Command="{Binding LoadExplicitHistoryCommand}"
                  IsEnabled="{Binding CanLoadExplicitHistory}"
                  ToolTip.Tip="Load bars for From→To (research shell step ②)" />
          <Border Width="1" Height="24" Background="#2A2E39" />
          <Button Content="Pan" Command="{Binding ArmPanModeCommand}"
                  ToolTip.Tip="Restore pan / zoom drag" />
          <Button Content="Place STOP" Command="{Binding ArmPlaceStopCommand}"
                  ToolTip.Tip="Click price pane to set stop (draft only)" />
          <Button Content="Place TARGET" Command="{Binding ArmPlaceTargetCommand}"
                  ToolTip.Tip="Click price pane to set target (draft only)" />
          <Border Width="1" Height="24" Background="#2A2E39" />
          </StackPanel>
          <TextBlock Text="Selected" FontSize="11" Foreground="#787B86" VerticalAlignment="Center" />
          <Border Background="#262B38" BorderBrush="#363A45" BorderThickness="1" CornerRadius="3"
                  Padding="8,4" VerticalAlignment="Center"
                  IsVisible="{Binding SelectedInstrument, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding SelectedInstrument.Contract.Symbol}" FontWeight="SemiBold"
                       FontSize="12" Foreground="#D1D4DC" />
          </Border>
          <TextBlock Text="Search" Margin="8,0,0,0" FontSize="11"
                     Foreground="#787B86" VerticalAlignment="Center" />
          <AutoCompleteBox Width="220"
                           Watermark="Search instruments…"
                           MinimumPrefixLength="0"
                           MinimumPopulateDelay="0:0:0.150"
                           MaxDropDownHeight="420"
                           FilterMode="None"
                           IsTextCompletionEnabled="False"
                           ValueMemberBinding="{Binding DisplayName}"
                           Text="{Binding InstrumentSearchText, Mode=TwoWay}"
                           ItemsSource="{Binding Instruments}"
                           SelectedItem="{Binding SelectedInstrument, Mode=TwoWay}">
            <AutoCompleteBox.ItemTemplate>
              <DataTemplate>
                <DockPanel MinWidth="340" LastChildFill="True">
                  <ItemsControl DockPanel.Dock="Right"
                                ItemsSource="{Binding Converter={StaticResource InstrumentTags}}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{Binding Background}" Padding="5,1" Margin="3,0,0,0">
                          <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                                     FontSize="10" FontWeight="SemiBold" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                </DockPanel>
              </DataTemplate>
            </AutoCompleteBox.ItemTemplate>
          </AutoCompleteBox>

          <TextBlock Text="Timeframe" Margin="6,0,0,0" FontSize="11"
                     Foreground="#787B86" VerticalAlignment="Center" />
          <ComboBox Width="76"
                    ItemsSource="{Binding Timeframes}"
                    SelectedItem="{Binding SelectedTimeframe}">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <StackPanel x:Name="ChartMarketViews" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Border Width="1" Height="24" Margin="6,0,0,0" Background="#2A2E39" />
            <TextBlock Text="Views" FontSize="10" Foreground="#787B86" VerticalAlignment="Center" />
            <Button Content="Order book"
                    Command="{Binding OpenChartOrderBookCommand}"
                    IsEnabled="{Binding CanOpenChartMarketView}"
                    ToolTip.Tip="Open the Order book for this chart's instrument. Live L2 — not a historical replay of the selected bars." />
            <Button Content="Footprint"
                    Command="{Binding OpenChartVolumeFootprintCommand}"
                    IsEnabled="{Binding CanOpenChartMarketView}"
                    ToolTip.Tip="Open Volume footprint for this chart's instrument." />
            <Button Content="Bookmap"
                    Command="{Binding OpenChartBookmapCommand}"
                    IsEnabled="{Binding CanOpenChartMarketView}"
                    ToolTip.Tip="Open Bookmap + VolBook for this chart's instrument." />
          </StackPanel>

          <Border Width="1" Height="24" Margin="6,0" Background="#2A2E39" />
          <TextBlock Text="PRESET" FontSize="10" FontWeight="SemiBold"
                     Foreground="#787B86" VerticalAlignment="Center" />
          <AutoCompleteBox Width="140"
                           Watermark="Preset name"
                           MinimumPrefixLength="0"
                           FilterMode="None"
                           ItemsSource="{Binding PresetNames}"
                           SelectedItem="{Binding SelectedPreset}"
                           Text="{Binding PresetName, Mode=TwoWay}"
                           ToolTip.Tip="Pick a preset or type a name to save" />
          <Button Content="💾" Command="{Binding SavePresetCommand}"
                  ToolTip.Tip="Save symbol, interval, chart type and indicators" />
          <Button Content="🗑" Command="{Binding DeletePresetCommand}"
                  ToolTip.Tip="Delete the selected preset" />

          <Border Width="1" Height="24" Margin="6,0" Background="#2A2E39" />
          <ToggleButton Content="⏸"
                        IsChecked="{Binding IsPaused}"
                        ToolTip.Tip="Pause display updates; the live stream continues underneath" />

          <!-- Standalone Charts: one capture entry (still multi-brush under the hood). -->
          <StackPanel x:Name="ResearchCaptureClassic" Orientation="Horizontal" Spacing="8"
                      VerticalAlignment="Center">
            <Button x:Name="ResearchCaptureButton" Content="Capture event"
                    Command="{Binding StartResearchSelectionCommand}"
                    IsEnabled="{Binding HasData}"
                    ToolTip.Tip="Select an observation window, then a separate future outcome window" />
            <Button x:Name="ResearchCancelCaptureButton" Content="Cancel capture"
                    Command="{Binding CancelResearchSelectionCommand}"
                    IsVisible="{Binding IsResearchRangeSelectionEnabled}" />
            <Button x:Name="ResearchSendSelectionButton" Content="Send to Builder"
                    Command="{Binding SendResearchSelectionCommand}"
                    IsEnabled="{Binding CanKeepResearchSetup}"
                    ToolTip.Tip="Send the setup interval and indicator parameters to Strategy Builder" />
            <TextBlock x:Name="ResearchSelectionSummaryText"
                       Text="{Binding ResearchSelectionSummary}"
                       Width="200" TextWrapping="Wrap" FontSize="10"
                       Foreground="#9AA0AC" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel x:Name="ResearchShellDraftWorkflow" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="1" Height="24" Margin="6,0" Background="#2A2E39" />
          <TextBlock Text="Stop" FontSize="10" Foreground="#9AA0AC" VerticalAlignment="Center" />
          <TextBox Width="72" Text="{Binding DraftStopPriceText}" Watermark="price"
                   ToolTip.Tip="Protective stop price for the chart strategy draft (not an order)" />
          <TextBlock Text="Target" FontSize="10" Foreground="#9AA0AC" VerticalAlignment="Center" />
          <TextBox Width="72" Text="{Binding DraftTargetPriceText}" Watermark="price"
                   ToolTip.Tip="Profit target price for the chart strategy draft (not an order)" />
          <Button Content="Send draft"
                  Command="{Binding SendStrategyDraftCommand}"
                  IsEnabled="{Binding CanSendStrategyDraft}"
                  ToolTip.Tip="Send stop/target draft to Strategy Builder. Does not place orders." />
          <Button Content="Clear draft"
                  Command="{Binding ClearStrategyDraftLevelsCommand}"
                  ToolTip.Tip="Clear stop and target draft fields" />
          <Button Content="Lock draft"
                  Command="{Binding RequestStrategyDraftLockCommand}"
                  ToolTip.Tip="Ask Builder to lock the sent draft to the active TradeIR hash" />
          <Button Content="Historical BT"
                  Command="{Binding RequestHistoricalBacktestCommand}"
                  ToolTip.Tip="Open same-kernel historical validation (not synthetic smoke)" />
          <TextBlock Text="{Binding StrategyDraftSummary}"
                     Width="220" TextWrapping="Wrap" FontSize="10"
                     Foreground="#9AA0AC" VerticalAlignment="Center" />
          </StackPanel>
          <Button Content="↧"
                  Command="{Binding ExportCsvCommand}"
                  IsEnabled="{Binding HasData}"
                  ToolTip.Tip="Export loaded bars and indicators as CSV" />
          <Button Content="📷" Click="ExportPng_Click" ToolTip.Tip="Save a PNG snapshot of the chart" />
          <Button Content="?" ToolTip.Tip="Chart help">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <Border Width="390" Padding="16" Background="#262B38"
                        BorderBrush="#363A45" BorderThickness="1" CornerRadius="4">
                  <StackPanel Spacing="8">
                    <TextBlock Text="READING THE CHART" FontSize="12" FontWeight="SemiBold" Foreground="#D1D4DC" />
                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#B2B5BE" LineHeight="17"
                               Text="Price — candles, bars, line or area. Scroll to zoom, drag to pan, and hover for OHLC.&#10;&#10;Research — drag a period on the chart, optionally add an outcome, then Find similar. Active indicators are included automatically.&#10;&#10;Volume — bottom histogram on the price pane.&#10;&#10;SMA 20 / EMA — overlays shared with backtesting.&#10;&#10;RSI 14 — separate pane with 30 / 70 bands.&#10;&#10;MACD 12·26·9 — histogram, MACD and signal in a separate pane." />
                  </StackPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>
          <ToggleButton x:Name="OptionsToggle" Content="⚙" IsChecked="True"
                        ToolTip.Tip="Show or hide chart options" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Selection bar: summary + restrained actions; Find similar is the primary control. -->
    <Border x:Name="ResearchCompareSteps"
            Grid.Row="1"
            Background="#161A24"
            BorderBrush="#2A2E39"
            BorderThickness="0,0,0,1"
            Padding="10,8"
            IsVisible="False">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="Select period"
                  Command="{Binding StartResearchSelectionCommand}"
                  IsEnabled="{Binding HasData}"
                  IsVisible="{Binding !HasResearchObservationRange}"
                  ToolTip.Tip="Drag across the chart to mark an observation. Boundaries and period appear on the chart." />
          <Button Content="Reselect"
                  Command="{Binding StartResearchSelectionCommand}"
                  IsEnabled="{Binding HasData}"
                  IsVisible="{Binding HasResearchObservationRange}"
                  ToolTip.Tip="Clear the current observation and drag a new period on the chart." />
          <Button Content="Add outcome"
                  Command="{Binding StartResearchResultSelectionCommand}"
                  IsVisible="{Binding CanStartResearchResultSelection}"
                  ToolTip.Tip="Optional. Drag a later amber interval for what happened after the observation." />
          <Button Content="Save observation"
                  Command="{Binding SendResearchSelectionCommand}"
                  IsEnabled="{Binding CanKeepResearchSetup}"
                  ToolTip.Tip="Save this period with the exact indicator settings currently on the chart." />
          <Button Content="Find similar"
                  FontWeight="SemiBold"
                  Background="#2962FF" Foreground="#FFFFFF"
                  Command="{Binding RequestFindSimilarChartsCommand}"
                  IsEnabled="{Binding CanKeepResearchSetup}"
                  ToolTip.Tip="Search history for comparable setups using this period and its indicators. Open Condition &amp; labels when you need universe or condition controls." />
          <Button Content="Cancel"
                  Command="{Binding CancelResearchSelectionCommand}"
                  IsVisible="{Binding IsResearchRangeSelectionEnabled}"
                  ToolTip.Tip="Cancel the current drag selection." />
        </StackPanel>
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding ResearchSelectionDetailSummary}"
                     FontSize="11" FontWeight="SemiBold" Foreground="#D1D4DC"
                     TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
          <TextBlock Text="{Binding ResearchSelectionSummary}"
                     FontSize="10" Foreground="#9AA0AC"
                     TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="1" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <local:NativeChartSurface x:Name="ChartSurface" Grid.Column="0" />

      <Border x:Name="OptionsRail"
              Grid.Column="1"
              Width="200"
              Padding="14"
              Background="#1E222D"
              BorderBrush="#2A2E39"
              BorderThickness="1,0,0,0"
              IsVisible="{Binding IsChecked, ElementName=OptionsToggle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="7">
            <TextBlock Text="CHART TYPE" FontSize="10" FontWeight="SemiBold" Foreground="#787B86" />
            <ComboBox ItemsSource="{Binding ChartTypes}"
                      SelectedItem="{Binding SelectedChartType}" Margin="0,0,0,8" />

            <StackPanel x:Name="IndicatorsPanel" Spacing="5">
              <TextBlock Text="INDICATORS" FontSize="10" FontWeight="SemiBold" Foreground="#787B86" />
              <CheckBox Content="SMA (20)" IsChecked="{Binding ShowSma}" />
              <CheckBox IsChecked="{Binding ShowEma}">
                <TextBlock FontSize="12">
                  <Run Text="EMA (" /><Run Text="{Binding EmaPeriod}" /><Run Text=")" />
                </TextBlock>
              </CheckBox>
              <CheckBox Content="RSI (14)" IsChecked="{Binding ShowRsi}" />
              <CheckBox Content="MACD (12·26·9)" IsChecked="{Binding ShowMacd}" />
              <CheckBox Content="Bollinger (20,2)" IsChecked="{Binding ShowBollinger}" />
              <CheckBox Content="Stochastic (14·3)" IsChecked="{Binding ShowStochastic}" />
              <CheckBox Content="ATR (14)" IsChecked="{Binding ShowAtr}" />
              <CheckBox Content="VWAP" IsChecked="{Binding ShowVwap}" />
              <CheckBox Content="ADX (14)" IsChecked="{Binding ShowAdx}" />
              <TextBlock Text="USER INDICATORS" Margin="0,8,0,0" FontSize="10" FontWeight="SemiBold" Foreground="#787B86"
                         IsVisible="{Binding UserIndicators.Count}" />
              <ItemsControl ItemsSource="{Binding UserIndicators}" IsVisible="{Binding UserIndicators.Count}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsEnabled}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding UserIndicatorsPath, StringFormat=Edit {0} to add SMA/EMA/RSI/ATR of any period.}"
                         Margin="0,3,0,0" FontSize="10" Foreground="#787B86" TextWrapping="Wrap" />
              <TextBlock Text="Oscillators open panes below price. Chat catalog picks toggle these same overlays."
                         Margin="0,3,0,0" FontSize="10" Foreground="#787B86" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border x:Name="StatusBar"
            Grid.Row="3"
            Padding="10,5"
            Background="#1E222D"
            BorderBrush="#2A2E39"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#787B86"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Border Grid.Column="1" Padding="7,2" Margin="8,0,0,0" CornerRadius="2"
                Background="#3D3220" IsVisible="{Binding IsPaused}">
          <TextBlock Text="⏸ PAUSED" FontSize="10" FontWeight="SemiBold" Foreground="#F7A600" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
